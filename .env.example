# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Any Gemini model that accepts audio input. Check AI Studio for the latest Flash model.
GEMINI_MODEL=gemini-3.5-flash
# Seconds of audio per chunk sent for analysis
CHUNK_SECONDS=5
# Risk score (0-100) at which the warning banner fires
ALERT_THRESHOLD=70
# Tried in order when the main model is slow, overloaded or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Give up on a model after this many seconds and try the next one
GEMINI_TIMEOUT_SECONDS=20
# Requests per minute allowed on your plan (free tier is 5); precompute paces itself to this
GEMINI_RPM=5
